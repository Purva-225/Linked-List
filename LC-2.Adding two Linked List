/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
// BY ADDITING TWO LL : TC: O(MAX(N1,N2)), SC: O(1). 

class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        ListNode* dummy = new ListNode(); 
        ListNode* temp = dummy; // because dummy points to newNodes head. 

        int carry = 0; 

        while(l1 != NULL || l2 != NULL || carry){
            int Sum = 0; 
            if(l1 != NULL){
              Sum += l1->val; 
              l1 = l1->next; 
        }
        if(l2 != NULL){
          Sum += l2->val; 
          l2 = l2->next; 
        }
        Sum += carry; 
        carry = Sum/10; 
         ListNode* Newnode = new ListNode(Sum % 10); 
          temp->next = Newnode; 
          temp = temp->next;  
        }
        return dummy->next; // dummy represents as head of newList.
    }
};
