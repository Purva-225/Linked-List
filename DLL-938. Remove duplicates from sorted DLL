/*
Definition of doubly linked list:
struct ListNode
{
    int val;
    ListNode *next;
    ListNode *prev;
    ListNode()
    {
        val = 0;
        next = NULL;
        prev = NULL;
    }
    ListNode(int data1)
    {
        val = data1;
        next = NULL;
        prev = NULL;
    }
    ListNode(int data1, ListNode *next1, ListNode *prev1)
    {
        val = data1;
        next = next1;
        prev = prev1;
    }
};
*/
//Tc: O(n) , Sc: O(1) 
class Solution {
public:
    ListNode * removeDuplicates(ListNode *head) {
        if(head == NULL || head->next == NULL){
            return head; 
        }
        ListNode* temp = head; 
        while(temp != NULL && temp->next != NULL){
            ListNode* Front = temp->next; 
           while(Front != NULL && Front->val == temp->val){
                ListNode* duplicate = Front; 
                Front = Front->next; 
                free(duplicate); 
          }
           temp->next = Front; 
           if(Front != NULL) Front->prev = temp; 
           temp = temp->next; 
        }
        return head; 
    }
};
