            carry = 1; 
            
           }else{
               
            carry = 0;
            
           }
           
         temp = temp->next; 
         
        }
         if(carry == 1){
             
        ListNode* newNode = new ListNode(1);
        temp = head;

        while(temp->next != NULL){
        
            temp = temp->next;
        }

        temp->next = newNode;
    }

    head = reverseList(head);

    return head;
   }
};

