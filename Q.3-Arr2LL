/*
// Representation of a node
class Node {
public:
    int data;
    Node* next;

    Node(int d) {
        data = d;
        next = NULL;
    }
};
*/

class Solution {
  public:
    Node* arrayToList(vector<int>& arr) {
        Node* Head = new Node(arr[0]); 
        Node* Mover = Head; 
        
        for(int i = 1; i<arr.size(); i++){
            Node* Temp = new Node(arr[i]); 
            Mover->next = Temp; 
            Mover = Temp; 
        }
        return Head; 
    }
};
