//Tc: O(N)+O(N) one of this is due to random pointers. Sc: O(N) due to mpp 
class Solution {
public:
    Node* copyRandomList(Node* head) {
        
        if(head == NULL){
           return NULL; 
        }

        Node* temp = head; 
        unordered_map<Node*,Node*>mpp; 

        while(temp != NULL){
            Node* Dummy = new Node(temp->val); 
            mpp[temp] = Dummy; 
            temp = temp->next; 
        }
        temp = head; 
        while(temp != NULL){
            Node* CopyNode = mpp[temp]; 
            CopyNode->next = mpp[temp->next]; 
            CopyNode->random = mpp[temp->random]; 
            temp = temp->next;
        }
         return mpp[head]; 
    }
};
